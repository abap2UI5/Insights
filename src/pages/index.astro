---
/* The index, built as the home page (https://abap2ui5.github.io/) is: the
 * title with the logo beside it, then one group per part - its name as the
 * small uppercase heading, its essays as tiles. The classes and the rules
 * are the home page's (.hello, .welcome, .group, .tiles, .tile). */
import Page from "../layouts/Page.astro";
import { getCollection } from "astro:content";
import { PARTS } from "../lib/parts";

const base = import.meta.env.BASE_URL;
const essays = (await getCollection("essays")).sort((a, b) => a.data.number - b.data.number);
const count = essays.length;
const description = `The ideas behind abap2UI5 in ${count} short technical essays: what it rests on, how it works under the app, a working day with it, where it belongs in the landscape and what running it takes.`;
---
<Page title={`abap2UI5 Insights — ${count} essays on one idea`} description={description} trail={[{ text: "Insights" }]}>
  <div class="hello">
    <div class="hello-text">
      <h1 class="welcome">Insights</h1>
      <p class="hello-lead">What happens when the ABAP server sends the <em>screen</em> instead of only the data — in {count} short essays.</p>
    </div>
    <img class="hello-logo" src={`${base}logo.png`} alt="" width="104" height="104">
  </div>
  {PARTS.map((part, i) => (
    <section class="group" id={part.id}>
      <h2>Part {i + 1} · {part.title}</h2>
      <ul class="tiles">
        {essays.filter((e) => e.data.part === part.id).map((e) => (
          <li>
            <a class="tile inside" href={`${base}${e.id}/`}>
              <span class="for">#{e.data.number}</span>
              <strong>{e.data.title}</strong>
              <span class="text">{e.data.blurb.charAt(0).toUpperCase() + e.data.blurb.slice(1)}.</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Page>
